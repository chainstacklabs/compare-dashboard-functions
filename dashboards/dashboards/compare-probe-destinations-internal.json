  "description": "Internal. Which destination IPs each chain and probe region connects to, and when that changes. Never enable public sharing.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 4248775412322304,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "description": "One row per chain, probe region and destination IP. A bar means requests went to that IP. A row that starts or stops is a change of destination.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "green",
            "mode": "fixed"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "transparent",
                  "index": 0,
                  "text": "not in use"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "from": 0.5,
                "result": {
                  "color": "green",
                  "index": 1,
                  "text": "in use"
                },
                "to": 1000000000
              },
              "type": "range"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "interval": "5m",
      "maxDataPoints": 300,
      "options": {
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "never",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "(count by (provider, blockchain, source_region, peer_ip) (count_over_time(probe_peer_latency_seconds{provider=~\"$provider\", blockchain=~\"$chain\", source_region=~\"$region\"}[$__interval])) > 0) or (0 * count by (provider, blockchain, source_region, peer_ip) (count_over_time(probe_peer_latency_seconds{provider=~\"$provider\", blockchain=~\"$chain\", source_region=~\"$region\"}[1h])))",
          "format": "time_series",
          "instant": false,
          "legendFormat": "{{blockchain}} \u00b7 {{source_region}} \u00b7 {{peer_ip}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Destination IPs over time",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "orderBy": [
              {
                "desc": false,
                "type": "name"
              }
            ],
            "orderByMode": "auto"
          }
        }
      ],
      "type": "state-timeline"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "description": "Every destination IP in the selected range: when it was first and last used, and its share of that chain and region's requests.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "First seen (UTC)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "min by (provider, blockchain, source_region, peer_ip) (min_over_time(timestamp(probe_peer_latency_seconds{provider=~\"$provider\", blockchain=~\"$chain\", source_region=~\"$region\"})[$__range:3m])) * 1000",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "first"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "max by (provider, blockchain, source_region, peer_ip) (max_over_time(timestamp(probe_peer_latency_seconds{provider=~\"$provider\", blockchain=~\"$chain\", source_region=~\"$region\"})[$__range:3m])) * 1000",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "last"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (provider, blockchain, source_region, peer_ip) (count_over_time(probe_peer_latency_seconds{provider=~\"$provider\", blockchain=~\"$chain\", source_region=~\"$region\"}[$__range])) / on (provider, blockchain, source_region) group_left sum by (provider, blockchain, source_region) (count_over_time(probe_peer_latency_seconds{provider=~\"$provider\", blockchain=~\"$chain\", source_region=~\"$region\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "share"
        }
      ],
      "title": "Destination IPs",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Value #first": 4,
              "Value #last": 5,
              "Value #share": 6,
              "blockchain": 0,
              "peer_ip": 3,
              "provider": 2,
              "source_region": 1
            },
            "renameByName": {
              "Value #first": "First seen (UTC)",
              "Value #last": "Last seen",
              "Value #share": "Share",
              "blockchain": "Chain",
              "peer_ip": "Destination IP",
              "provider": "Provider",
              "source_region": "Region"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "Last seen"
              }
            ]
          }
        }
      ],
      "type": "table"
    }
  ],
