    {
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "**Pick a chain and region, find the spike, then zoom to it.** Spike + **new destination IP** and high connect time \u2192 requests landed in the wrong place. Spike + **unusual source location** and high connect time \u2192 Vercel sent from a bad egress. Spike with **usual source and destination** and normal connect time \u2192 the node itself was slow.",
        "mode": "markdown"
      },
      "title": "",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "description": "Chainstack RPC time per method, one point per probe.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "points",
            "pointSize": 5,
            "showPoints": "always"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "interval": "3m",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "max by (api_method) (max_over_time(probe_route_seconds{metric_type=\"route_rpc\", blockchain=\"$chain\", source_region=\"$region\"}[$__interval]))",
          "format": "time_series",
          "instant": false,
          "legendFormat": "{{api_method}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "1 \u00b7 RPC time",
      "type": "timeseries"
    },
